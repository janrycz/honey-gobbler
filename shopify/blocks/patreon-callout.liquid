{% comment %}
  Patreon call-out for the waitlist page. All the text is editable in the theme editor.
  The Patreon and Discord icons are built into the stylesheet below as single-colour masks, painted
  in the text colour, so they always match the text, including when the button changes on hover.
{% endcomment %}

<div
  class="patreon-callout"
  style="
    {% if block.settings.background_color != blank %}--patreon-callout-bg: {{ block.settings.background_color }};{% endif %}
    {% if block.settings.border_color != blank %}--patreon-callout-border: {{ block.settings.border_color }};{% endif %}
  "
  {{ block.shopify_attributes }}
>
  {%- if block.settings.heading != blank or block.settings.note != blank -%}
    <div class="patreon-callout__intro">
      {%- if block.settings.heading != blank -%}
        <h2 class="patreon-callout__heading h4">{{ block.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if block.settings.note != blank -%}
        <p class="patreon-callout__note">{{ block.settings.note | escape }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- if block.settings.link != blank -%}
    <a
      class="button-secondary patreon-callout__button"
      href="{{ block.settings.link }}"
      target="_blank"
      rel="noopener noreferrer"
    >
      <span class="patreon-callout__icon patreon-callout__icon--patreon" aria-hidden="true"></span>
      <span>{{ block.settings.link_label | default: block.settings.link | escape }}</span>
    </a>
  {%- endif -%}

  {%- if block.settings.perk != blank -%}
    <p class="patreon-callout__perk">
      <span class="patreon-callout__icon patreon-callout__icon--discord" aria-hidden="true"></span>
      <span class="patreon-callout__perk-text">{{ block.settings.perk | escape }}</span>
    </p>
  {%- endif -%}
</div>

{% stylesheet %}
  .patreon-callout {
    width: 100%;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--gap-lg, 1.5rem);
    padding: 2rem 1.5rem;
    text-align: center;
    color: var(--color-foreground);
    background-color: var(--patreon-callout-bg, transparent);
    border: 1px solid var(--patreon-callout-border, transparent);
    border-radius: 16px;
  }

  .patreon-callout > *,
  .patreon-callout__intro > * {
    margin: 0;
  }

  .patreon-callout__intro {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
  }

  .patreon-callout__heading {
    text-wrap: balance;
  }

  .patreon-callout__note {
    font-style: italic;
    font-size: 0.875em;
    opacity: 0.75;
  }

  .patreon-callout .patreon-callout__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6em;
    text-decoration: none;
  }

  .patreon-callout__perk {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
  }

  .patreon-callout__perk-text {
    text-align: left;
    text-wrap: balance;
  }

  .patreon-callout__icon {
    flex: none;
    display: inline-block;
    width: 1.5em;
    height: 1.5em;
    background-color: currentColor;
    -webkit-mask: var(--icon) center / contain no-repeat;
    mask: var(--icon) center / contain no-repeat;
  }

  .patreon-callout__icon--patreon {
    --icon: url("data:image/png;base64,");
  }

  .patreon-callout__icon--discord {
    --icon: url("data:image/png;base64,");
  }

  @media screen and (max-width: 749px) {
    .patreon-callout {
      padding: 1.5rem 1rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Patreon call-out",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Join my Patreon to get an even bigger discount at launch!"
    },
    {
      "type": "text",
      "id": "note",
      "label": "Small print",
      "default": "UK and EU only"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Patreon link"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Button text",
      "default": "Patreon.com/janrycz"
    },
    {
      "type": "text",
      "id": "perk",
      "label": "Line next to the Discord icon",
      "default": "+ Permanent access to my Discord server"
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#FDF6E4"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border",
      "default": "#E9D9BB"
    }
  ],
  "presets": [
    {
      "name": "Patreon call-out",
      "category": "t:categories.basic"
    }
  ]
}
{% endschema %}
