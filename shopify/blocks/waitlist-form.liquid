{% comment %}
  Waitlist signup. Same look as the old contact form: first name, last name, email, optional country, optional comment.
  but it signs people up as email subscribers tagged "waitlist", so Shopify Email can tell them when the honey is back.
  Country goes into a tag ("Country: ..."), the comment into the customer note.
  On success it also leaves a note in the browser that unlocks "The real thing" in Honey Gobbler.
{% endcomment %}

{% capture submit_button %}
  {% content_for 'block', type: 'contact-form-submit-button', id: 'submit-button' %}
{% endcapture %}

<div
  class="contact-form spacing-style size-style"
  style="
    {% render 'spacing-style', settings: block.settings %}
    {% render 'size-style', settings: block.settings %}
    {% if block.settings.background_color != blank %}background-color: {{ block.settings.background_color }};{% endif %}
    {% if block.settings.input_style == 'custom' %}
      {% render 'input-custom-styles', block_settings: block.settings %}
      --style-border-width-inputs: {{ block.settings.border_width }}px;
      --style-border-radius-inputs: {{ block.settings.border_radius }}px;
    {% endif %}
  "
  {{ block.shopify_attributes }}
>
  {% assign form_id = block.id | prepend: 'WaitlistForm-' %}
  {%- form 'customer', id: form_id, class: 'contact-form__form' -%}
    <input type="hidden" name="contact[tags]" value="waitlist">

    {%- if form.errors -%}
      <div
        class="contact-form__error"
        tabindex="-1"
        autofocus
      >
        {{- 'icon-error.svg' | inline_asset_content -}}

        {{- form.errors.translated_fields.email | capitalize }}
        {{ form.errors.messages.email -}}
      </div>
    {%- endif -%}

    {%- if form.posted_successfully? -%}
      <div
        class="contact-form__success"
        tabindex="-1"
        autofocus
      >
        {{- 'icon-checkmark.svg' | inline_asset_content -}}
        Thanks for joining the waitlist! We'll get back to you with updates in sha Allah
      </div>
      <script>
        try { localStorage.setItem('honey-gobbler-waitlist', '1'); } catch (e) {}
      </script>
    {%- endif -%}

    <div class="contact-form__form-row">
      <label
        class="visually-hidden"
        for="{{ form_id }}-first"
      >
        First name
      </label>
      <input
        type="text"
        id="{{ form_id }}-first"
        class="contact-form__input"
        autocomplete="given-name"
        name="contact[first_name]"
        value="{% if customer %}{{ customer.first_name | escape }}{% endif %}"
        placeholder="First name"
      >

      <label
        class="visually-hidden"
        for="{{ form_id }}-last"
      >
        Last name
      </label>
      <input
        type="text"
        id="{{ form_id }}-last"
        class="contact-form__input"
        autocomplete="family-name"
        name="contact[last_name]"
        value="{% if customer %}{{ customer.last_name | escape }}{% endif %}"
        placeholder="Last name"
      >
    </div>

    <div class="contact-form__form-row">
      <label
        class="visually-hidden"
        for="{{ form_id }}-email"
      >
        {{- 'blocks.contact_form.email' | t -}}
        <span aria-hidden="true">*</span></label
      >
      <input
        type="email"
        id="{{ form_id }}-email"
        class="contact-form__input"
        autocomplete="email"
        name="contact[email]"
        spellcheck="false"
        autocapitalize="off"
        value="{% if form.email %}{{ form.email | escape }}{% elsif customer %}{{ customer.email | escape }}{% endif %}"
        aria-required="true"
        required
        {% if form.errors contains 'email' %}
          aria-invalid="true"
        {% endif %}
        placeholder="{{ 'blocks.contact_form.email' | t }}"
      >
    </div>

    <label
      class="visually-hidden"
      for="{{ form_id }}-country"
    >
      Country
    </label>
    <input
      type="text"
      id="{{ form_id }}-country"
      class="contact-form__input"
      autocomplete="country-name"
      data-waitlist-country
      placeholder="Country (optional)"
    >

    <label
      class="visually-hidden"
      for="{{ form_id }}-body"
    >
      {{- 'blocks.contact_form.comment' | t -}}
    </label>
    <textarea
      rows="10"
      id="{{ form_id }}-body"
      class="contact-form__input contact-form__input--textarea"
      name="contact[note]"
      placeholder="Comment (optional)"
    ></textarea>

    {{ submit_button }}
  {%- endform -%}
  <script>
    (function () {
      var f = document.getElementById('{{ form_id }}');
      if (!f) return;
      f.addEventListener('submit', function () {
        var c = f.querySelector('[data-waitlist-country]'), t = f.querySelector('input[name="contact[tags]"]');
        var v = ((c && c.value) || '').replace(/[,<>"]/g, ' ').replace(/\s+/g, ' ').trim().slice(0, 60);
        if (t) t.value = 'waitlist' + (v ? ', Country: ' + v : '');
      });
    })();
  </script>
</div>

{% stylesheet %}
  .contact-form__form {
    display: flex;
    flex-direction: column;
    gap: var(--gap-md);
  }

  .contact-form__form-row {
    display: flex;
    flex-direction: column;
    gap: var(--gap-md);

    @media screen and (min-width: 750px) {
      flex-direction: row;
      align-items: center;
    }
  }

  .contact-form__input {
    width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    color: var(--color-input-text);
    background-color: var(--color-input-background);
    padding: var(--padding-lg) var(--padding-xl);
    border-radius: var(--style-border-radius-inputs);
    border: var(--style-border-width-inputs) solid var(--color-input-border);
    -webkit-font-smoothing: antialiased;
  }

  .contact-form__input--textarea {
    resize: vertical;
    min-height: var(--input-textarea-min-height);
  }

  .contact-form__error,
  .contact-form__success {
    display: flex;
    align-items: center;
    gap: var(--gap-xs);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Waitlist form",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "Signs people up as email subscribers tagged \"waitlist\". Find them under Customers, or email them with Shopify Email."
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:settings.width_desktop",
      "options": [
        { "value": "fit-content", "label": "t:options.fit_content" },
        { "value": "custom", "label": "t:options.custom" }
      ],
      "default": "fit-content"
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "t:settings.width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width == 'custom' }}"
    },
    {
      "type": "select",
      "id": "width_mobile",
      "label": "t:settings.width_mobile",
      "options": [
        { "value": "fit-content", "label": "t:options.fit_content" },
        { "value": "custom", "label": "t:options.custom" }
      ],
      "default": "fit-content"
    },
    {
      "type": "range",
      "id": "custom_width_mobile",
      "label": "t:settings.width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width_mobile == 'custom' }}"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.input"
    },
    {
      "type": "select",
      "id": "input_style",
      "label": "t:settings.style",
      "options": [
        { "value": "default", "label": "t:options.default" },
        { "value": "custom", "label": "t:options.custom" }
      ],
      "default": "default",
      "info": "t:info.edit_input_field_in_theme_settings"
    },
    {
      "type": "color",
      "id": "input_background_color",
      "label": "t:settings.background",
      "default": "{{ settings.color_palette.background }}",
      "visible_if": "{{ block.settings.input_style == \"custom\" }}"
    },
    {
      "type": "color",
      "id": "input_text_color",
      "label": "t:settings.text",
      "default": "{{ settings.color_palette.foreground }}",
      "visible_if": "{{ block.settings.input_style == \"custom\" }}"
    },
    {
      "type": "color",
      "id": "input_border_color",
      "label": "t:settings.borders",
      "default": "{{ settings.color_palette.foreground }}",
      "visible_if": "{{ block.settings.input_style == \"custom\" }}"
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "t:settings.border_width",
      "min": 0,
      "max": 4,
      "step": 0.5,
      "unit": "px",
      "default": 1,
      "visible_if": "{{ block.settings.input_style == \"custom\" }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.input_style == \"custom\" }}"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Waitlist form",
      "category": "t:categories.forms"
    }
  ]
}
{% endschema %}
