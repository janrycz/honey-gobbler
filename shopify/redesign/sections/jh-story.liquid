{% render 'jh-tokens' %}

{%- comment -%}
  Image with text. Used for "Our story" and "The apiary".
  Optional "Step" blocks show as a numbered list under the text.
{%- endcomment -%}

<section
  {% if section.settings.anchor_id != blank %}id="{{ section.settings.anchor_id | handleize }}"{% endif %}
  class="jh jh-section jh-story jh-bg--{{ section.settings.background }}{% if section.settings.image_side == 'right' %} jh-story--image-right{% endif %}"
>
  <div class="jh-container jh-story__grid">
    <div class="jh-story__media">
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 1600
          | image_tag:
            widths: '600, 900, 1200, 1600',
            sizes: '(min-width: 990px) 45vw, 100vw',
            loading: 'lazy',
            alt: section.settings.image.alt | default: section.settings.heading
        }}
      {%- else -%}
        <div class="jh-story__placeholder">{{ 'image' | placeholder_svg_tag }}</div>
      {%- endif -%}
      {%- if section.settings.caption != blank -%}
        <p class="jh-story__caption">{{ section.settings.caption | escape }}</p>
      {%- endif -%}
    </div>

    <div class="jh-story__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="jh-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="jh-title">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="jh-body">{{ section.settings.text }}</div>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        {%- if section.settings.steps_heading != blank -%}
          <h3 class="jh-story__steps-heading">{{ section.settings.steps_heading | escape }}</h3>
        {%- endif -%}
        <ol class="jh-steps" role="list">
          {%- for block in section.blocks -%}
            <li class="jh-steps__item" {{ block.shopify_attributes }}>
              <span class="jh-steps__number" aria-hidden="true">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
              <p class="jh-steps__text">{{ block.settings.text | escape }}</p>
            </li>
          {%- endfor -%}
        </ol>
      {%- endif -%}

      {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
        <a class="button-secondary jh-story__button" href="{{ section.settings.button_link }}">
          {{- section.settings.button_label | escape -}}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .jh-story__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    align-items: center;
  }

  @media screen and (min-width: 990px) {
    .jh-story__grid {
      grid-template-columns: 1fr 1fr;
      gap: clamp(56px, 7vw, 112px);
    }

    .jh-story--image-right .jh-story__media {
      order: 2;
    }
  }

  .jh-story__media img,
  .jh-story__placeholder {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 4px;
    background-color: var(--jh-sand);
  }

  .jh-story__placeholder svg {
    width: 100%;
    height: 100%;
    opacity: 0.4;
  }

  @media screen and (max-width: 989px) {
    .jh-story__media img,
    .jh-story__placeholder {
      aspect-ratio: 4 / 3;
    }
  }

  .jh-story__caption {
    margin: 10px 0 0;
    font-size: 0.8125rem;
    opacity: 0.7;
  }

  .jh-story__steps-heading {
    margin: 40px 0 0;
    font-family: var(--font-body--family);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--jh-amber);
  }

  .jh-steps {
    display: grid;
    gap: 18px;
    margin: 18px 0 0;
    padding: 22px 0 0;
    border-top: 1px solid var(--jh-line);
    list-style: none;
  }

  .jh-steps__item {
    display: grid;
    grid-template-columns: 44px 1fr;
    align-items: baseline;
    gap: 8px;
  }

  .jh-steps__number {
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight, 600);
    font-size: 1.5rem;
    line-height: 1;
    color: var(--jh-amber);
  }

  .jh-steps__text {
    margin: 0;
    font-size: 1rem;
    line-height: 1.6;
  }

  .jh-story .jh-story__button {
    margin-top: 32px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "JH image with text",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Anchor for links", "info": "For example our-story, so links to /#our-story scroll here." },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "caption", "label": "Image caption" },
    {
      "type": "select",
      "id": "image_side",
      "label": "Image side on computers",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "ivory", "label": "Ivory" },
        { "value": "sand", "label": "Sand" },
        { "value": "green", "label": "Forest green" }
      ],
      "default": "ivory"
    },
    { "type": "text", "id": "eyebrow", "label": "Small line above heading" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "steps_heading", "label": "Heading above steps" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [{ "type": "textarea", "id": "text", "label": "Text" }]
    }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "JH image with text" }]
}
{% endschema %}
