{% render 'jh-tokens' %}

{%- liquid
  assign img = section.settings.image
  assign img_mobile = section.settings.image_mobile | default: img
  assign overlay = section.settings.overlay | divided_by: 100.0
-%}

<section
  class="jh jh-hero jh-hero--{{ section.settings.height }}"
  style="--jh-overlay: {{ overlay }}; --jh-focus: {{ section.settings.image_position }};"
>
  <div class="jh-hero__media">
    {%- if img != blank -%}
      {{
        img_mobile
        | image_url: width: 1500
        | image_tag:
          class: 'jh-hero__img jh-hero__img--mobile',
          widths: '500, 750, 1000, 1500',
          sizes: '100vw',
          loading: 'eager',
          fetchpriority: 'high',
          alt: ''
      }}
      {{
        img
        | image_url: width: 3000
        | image_tag:
          class: 'jh-hero__img jh-hero__img--desktop',
          widths: '1000, 1500, 2000, 2500, 3000',
          sizes: '100vw',
          loading: 'eager',
          alt: ''
      }}
    {%- endif -%}
  </div>

  <div class="jh-container jh-hero__content">
    {%- if section.settings.eyebrow != blank -%}
      <p class="jh-eyebrow jh-hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h1 class="jh-hero__title">{{ section.settings.heading | escape }}</h1>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <p class="jh-hero__text">{{ section.settings.text | escape }}</p>
    {%- endif -%}
    <div class="jh-hero__actions">
      {%- if section.settings.button_label != blank -%}
        <a class="button jh-hero__button" href="{{ section.settings.button_link | default: '#shop' }}">
          {{- section.settings.button_label | escape -}}
        </a>
      {%- endif -%}
      {%- if section.settings.link_label != blank -%}
        <a class="jh-hero__link" href="{{ section.settings.link_url | default: '#our-story' }}">
          {{- section.settings.link_label | escape -}}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .jh-hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: 88svh;
    overflow: hidden;
    background-color: var(--jh-green);
    color: var(--jh-ivory);
  }

  .jh-hero--medium {
    min-height: 70svh;
  }

  .jh-hero--small {
    min-height: 52svh;
  }

  .jh-hero__media,
  .jh-hero__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .jh-hero__img {
    object-fit: cover;
    object-position: var(--jh-focus, center);
  }

  .jh-hero__img--desktop {
    display: none;
  }

  @media screen and (min-width: 750px) {
    .jh-hero__img--mobile {
      display: none;
    }

    .jh-hero__img--desktop {
      display: block;
    }
  }

  .jh-hero__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgb(18 22 17 / calc(var(--jh-overlay) + 0.25)) 0%,
      rgb(18 22 17 / var(--jh-overlay)) 45%,
      rgb(18 22 17 / calc(var(--jh-overlay) * 0.6)) 100%
    );
  }

  .jh-hero__content {
    position: relative;
    z-index: 1;
    padding-block: 140px clamp(56px, 9vw, 104px);
  }

  .jh-hero__eyebrow {
    color: var(--jh-ivory);
    opacity: 0.9;
  }

  .jh-hero__title {
    max-width: 11em;
    margin: 0 0 20px;
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight, 600);
    font-size: clamp(2.75rem, 7.5vw, 5.75rem);
    line-height: 0.98;
    letter-spacing: -0.015em;
    color: var(--jh-ivory);
    text-wrap: balance;
  }

  .jh-hero__text {
    max-width: 30em;
    margin: 0 0 36px;
    font-size: clamp(1.0625rem, 1.6vw, 1.25rem);
    line-height: 1.55;
    opacity: 0.92;
  }

  .jh-hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 32px;
  }

  .jh-hero .jh-hero__button {
    min-width: 200px;
    justify-content: center;
  }

  .jh-hero__link {
    color: var(--jh-ivory);
    font-size: 1rem;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 6px;
  }

  .jh-hero__link:hover {
    opacity: 0.8;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "JH hero",
  "tag": "div",
  "class": "jh-hero-wrapper",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "image_picker", "id": "image_mobile", "label": "Phone image (optional)", "info": "Leave empty to use the main image." },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image focus",
      "options": [
        { "value": "center", "label": "Centre" },
        { "value": "top", "label": "Top" },
        { "value": "bottom", "label": "Bottom" },
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "options": [
        { "value": "full", "label": "Tall" },
        { "value": "medium", "label": "Medium" },
        { "value": "small", "label": "Short" }
      ],
      "default": "full"
    },
    { "type": "range", "id": "overlay", "label": "Darken image", "min": 0, "max": 70, "step": 5, "unit": "%", "default": 30 },
    { "type": "text", "id": "eyebrow", "label": "Small line above heading", "default": "Family apiary, Podkarpackie, Poland" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Raw Polish honeydew honey" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop honey" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "link_label", "label": "Second link label", "default": "Our story" },
    { "type": "url", "id": "link_url", "label": "Second link" }
  ],
  "presets": [{ "name": "JH hero" }]
}
{% endschema %}
