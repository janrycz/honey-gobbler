        "custom_liquid_Pa8RyK": {
          "type": "custom-liquid",
          "name": "t:names.custom_liquid",
          "settings": {
            "custom_liquid": "{% liquid\n  assign max_uk = 13\n  assign max_eu = 19\n\n  assign p = closest.product\n  if p == blank\n    assign p = product\n  endif\n  assign v = p.selected_or_first_available_variant\n\n  if localization.country.iso_code == 'GB'\n    assign qty = v.metafields.custom.stock_uk.value\n    assign max = max_uk\n  else\n    assign qty = v.metafields.custom.stock_eu.value\n    assign max = max_eu\n  endif\n\n  assign hexchars = '0123456789ABCDEF'\n\n  assign g_now = 0\n  if qty != blank and max > 0\n    assign g_now = qty | times: 255 | divided_by: max\n    if g_now > 255\n      assign g_now = 255\n    endif\n  endif\n\n  assign g_half = g_now | divided_by: 2\n\n  assign hi = g_now | divided_by: 16\n  assign lo = g_now | modulo: 16\n  assign hichar = hexchars | slice: hi, 1\n  assign lochar = hexchars | slice: lo, 1\n  assign col_now = '#FF' | append: hichar | append: lochar | append: '00'\n\n  assign hi2 = g_half | divided_by: 16\n  assign lo2 = g_half | modulo: 16\n  assign hichar2 = hexchars | slice: hi2, 1\n  assign lochar2 = hexchars | slice: lo2, 1\n  assign col_half = '#FF' | append: hichar2 | append: lochar2 | append: '00'\n\n  assign fg = '#FFFFFF'\n  if g_now > 130\n    assign fg = '#000000'\n  endif\n\n  if qty == 0\n    assign bg = '#FF0000'\n    assign fg = '#FFFFFF'\n    assign msg = 'Sold out'\n  elsif qty == 1\n    assign bg = '#FF0000'\n    assign msg = 'Only 1 left!'\n  else\n    assign bg = 'linear-gradient(to right, ' | append: col_now | append: ', ' | append: col_half | append: ')'\n    assign msg = 'Only ' | append: qty | append: ' left!'\n  endif\n%}\n\n{% if qty != blank %}\n<div class=\"stockbadge-pdp\" style=\"position:absolute;top:0.8em;right:0.8em;z-index:50;padding:0.55em 0.9em;border-radius:0.45em;background:{{ bg }};color:{{ fg }};font-size:clamp(13px, 1.4vw, 21px);font-weight:600;line-height:1.2;white-space:nowrap;pointer-events:none;opacity:0;transition:opacity .15s;\">{{ msg }}</div>\n\n<script>\n(function () {\n  function init() {\n    var badge = document.querySelector('.stockbadge-pdp:not([data-moved])');\n    if (!badge) return;\n\n    var img = document.querySelector('.product-media-container img');\n    if (!img) return;\n\n    badge.setAttribute('data-moved', '1');\n\n    var wrap = document.createElement('span');\n    wrap.style.position = 'relative';\n    wrap.style.display = 'inline-block';\n    wrap.style.maxWidth = '100%';\n    wrap.style.lineHeight = '0';\n\n    img.parentNode.insertBefore(wrap, img);\n    wrap.appendChild(img);\n    wrap.appendChild(badge);\n\n    badge.style.lineHeight = '1.2';\n    badge.style.opacity = '1';\n  }\n\n  if (document.readyState === 'loading') {\n    document.addEventListener('DOMContentLoaded', init);\n  } else {\n    init();\n  }\n})();\n</script>\n{% endif %}"
          },
          "blocks": {}
        },
